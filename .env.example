# lynx-patch-watch secrets — copy to .env and never commit .env.
# Generate the admin password hash with:  lpw hash-password
LPW_ADMIN_PASSWORD_HASH=

# Optional: NVD API key (reserved for future enrichment; unused today).
# LPW_NVD_API_KEY=

# Optional: credentials referenced from project git URLs as ${ENV_VAR}.
# Example git_url: https://${LPW_GIT_USER}:${LPW_GIT_TOKEN}@git.example.com/repo.git
# LPW_GIT_USER=
# LPW_GIT_TOKEN=

# Root directory override (defaults to the current working directory).
# LPW_ROOT=/path/to/lynx-patch-watch

# Session cookie signing key (random per process when unset → logins lost on restart).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# LPW_SESSION_SECRET=
